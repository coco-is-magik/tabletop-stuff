# Shared automatic ability: never attach to Pathfinder's global Default ability.
# Fixed INT is a prototype fixture, not a universal casting tradition.
Spheres Casting Core	CATEGORY:Special Ability	TYPE:SpheresInternal	VISIBLE:NO	DEFINE:SPHERES_MAGIC_TALENTS|2	DEFINE:SPHERES_CASTER_LEVEL|0	DEFINE:SPHERES_CASTING_ABILITY|INT	DEFINE:SPHERES_MAGIC_SKILL_BONUS|0	DEFINE:SPHERES_SPELL_POOL_LEVELS|0	DEFINE:SPHERES_SPELL_POINTS|max(1,SPHERES_SPELL_POOL_LEVELS+SPHERES_CASTING_ABILITY)	DEFINE:SPHERES_DESTRUCTION_CL_BONUS|0	DEFINE:SPHERES_CL_DESTRUCTION|max(1,SPHERES_CASTER_LEVEL+SPHERES_DESTRUCTION_CL_BONUS)	DEFINE:SPHERES_DC_DESTRUCTION|10+floor(SPHERES_CL_DESTRUCTION/2)+SPHERES_CASTING_ABILITY	DEFINE:SPHERES_DESTRUCTION_DICE|max(1,floor((SPHERES_CL_DESTRUCTION+1)/2))	DEFINE:SPHERES_DESTRUCTION_BOOSTED_DICE|max(2,SPHERES_CL_DESTRUCTION)	DEFINE:SPHERES_DESTRUCTION_RANGE|25+5*floor(SPHERES_CL_DESTRUCTION/2)